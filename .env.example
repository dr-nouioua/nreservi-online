# --- Database (Postgres on your VPS or any provider) ---
DATABASE_URL=postgres://nreservi:nreservi@127.0.0.1:5432/nreservi

# --- Session signing (REQUIRED in production) ---
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- Cron jobs ---
# Protects POST /api/cron/reservation-reminders (hourly reminders).
# Generate with: openssl rand -hex 24
CRON_SECRET=

# --- WhatsApp Business API (optional) ---
# When set, the inbound webhook rejects requests without a valid
# X-Hub-Signature-256 signature from Meta.
WHATSAPP_APP_SECRET=

# --- Admin portal ---
# /admin responds 404 unless unlocked via /{ADMIN_PORTAL_KEY} (valid 12h)
ADMIN_PORTAL_KEY=3991

# --- Server binding ---
HOST=0.0.0.0
PORT=3000
